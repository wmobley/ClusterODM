FROM node:20-bullseye

LABEL maintainer="Local development"

EXPOSE 3000

USER root

# node:20-bullseye already provides curl, Python, build tools, and CA
# certificates. The local compose stack disables the admin CLI, so telnet and
# the extra libcurl development package are not required here.

RUN mkdir /var/www
WORKDIR "/var/www"

COPY --chown=node:node . /var/www

RUN npm install

RUN chown -R node:node /var/www

USER node

VOLUME ["/var/www/data"]
ENTRYPOINT ["/usr/local/bin/node", "/var/www/index.js"]
